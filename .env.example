# Local development placeholders only. Copy to .env and replace the password locally.
# Never use placeholder credentials in a shared or production environment.
MONGODB_URI="mongodb://freshprawns_dev:replace-local-password@127.0.0.1:27017/freshprawns?authSource=admin"
HOST="127.0.0.1"
PORT="4000"
NODE_ENV="development"
LOG_LEVEL="info"
CORS_ORIGINS="http://localhost:5173"
RATE_LIMIT_WINDOW_MS="900000"
RATE_LIMIT_MAX="120"

# Docker Compose uses these only for the local MongoDB container.
MONGO_INITDB_ROOT_USERNAME="freshprawns_dev"
MONGO_INITDB_ROOT_PASSWORD="replace-local-password"
