{
  "name": "fresh-prawns-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --watch --env-file=../.env --import tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file=../.env dist/src/index.js",
    "create:admin": "node --env-file=../.env --import tsx scripts/create-admin.ts",
    "seed:sample": "node --env-file=../.env --import tsx scripts/seed-sample-catalogue.ts",
    "lint": "eslint src test scripts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "argon2": "^0.45.2",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jose": "^6.2.17",
    "mongoose": "^8.19.0",
    "pino": "^9.14.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.0",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.36.0",
    "supertest": "^7.1.4",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.73.0",
    "vitest": "^3.2.4"
  }
}
